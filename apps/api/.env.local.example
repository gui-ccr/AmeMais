# URL do projeto Supabase
SUPABASE_URL=

# Anon key do Supabase (pública). Usada pra montar um client por-requisição
# com o token do próprio usuário, pra RLS decidir o que ele pode fazer.
SUPABASE_ANON_KEY=

# Service role key do Supabase (uso exclusivo no backend, nunca expor no front)
SUPABASE_SERVICE_ROLE_KEY=

# JWT secret do Supabase, usado para validar o access_token enviado pelo frontend
SUPABASE_JWT_SECRET=

# Origins dos frontends permitidas no CORS, separadas por vírgula (ver
# middleware.ts na raiz do app).
ALLOWED_ORIGINS=http://localhost:3002,http://localhost:3003

# URL do site público (apps/web-public). A API avisa o site quando animais,
# urgências ou pontos de coleta mudam, para ele limpar o cache na hora
# (POST {WEB_PUBLIC_URL}/api/revalidate). Ver ADR 0009. Sem ela, nada é enviado.
WEB_PUBLIC_URL=http://localhost:3002

# Segredo compartilhado com o site. Use o MESMO valor de REVALIDATE_SECRET do
# apps/web-public (texto longo e aleatório; nunca versionar o valor real).
REVALIDATE_SECRET=
