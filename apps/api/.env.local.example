# URL do projeto Supabase
SUPABASE_URL=

# Anon key do Supabase (pública). Usada pra montar um client por-requisição
# com o token do próprio usuário, pra RLS decidir o que ele pode fazer.
SUPABASE_ANON_KEY=

# Service role key do Supabase (uso exclusivo no backend, nunca expor no front)
SUPABASE_SERVICE_ROLE_KEY=

# JWT secret do Supabase, usado para validar o access_token enviado pelo frontend
SUPABASE_JWT_SECRET=

# Origins dos frontends permitidas no CORS, separadas por vírgula (ver
# middleware.ts na raiz do app).
ALLOWED_ORIGINS=http://localhost:3002,http://localhost:3003
