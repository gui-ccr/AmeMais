# URL do projeto Supabase
SUPABASE_URL=

# Service role key do Supabase (uso exclusivo no backend, nunca expor no front)
SUPABASE_SERVICE_ROLE_KEY=

# JWT secret do Supabase, usado para validar o access_token enviado pelo apps/web
SUPABASE_JWT_SECRET=

# Origin do apps/web permitida no CORS (ex: http://localhost:3000)
ALLOWED_ORIGIN=http://localhost:3000
