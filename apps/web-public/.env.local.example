# URL e anon key do projeto Supabase (públicas, usadas no browser)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# URL do apps/api
NEXT_PUBLIC_API_URL=http://localhost:3001

# URL do apps/api usada pelas buscas do servidor (Server Components, ver
# src/lib/api.ts). Não vai para o bundle do browser. Se não for definida, o
# site usa NEXT_PUBLIC_API_URL.
API_URL=http://localhost:3001

# URL pública do site (usada em metadata, sitemap.xml e robots.txt) — trocar
# pelo domínio de produção quando estiver definido (ex: https://amemais.org.br)
NEXT_PUBLIC_SITE_URL=http://localhost:3002

# Segredo que a apps/api manda em POST /api/revalidate (cabeçalho
# x-revalidate-secret) para o site limpar o cache na hora quando algo muda.
# Sem ele a rota responde 503 e vale só o prazo de segurança do cache. Gere um
# valor longo e aleatório e use o MESMO valor no apps/api.
REVALIDATE_SECRET=
